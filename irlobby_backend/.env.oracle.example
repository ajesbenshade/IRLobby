# Oracle VM / Nginx
SERVER_NAME=your-domain.com

# Database mode
# false => managed/external PostgreSQL
# true  => local PostgreSQL container (compose profile: localdb)
USE_LOCAL_POSTGRES=false

# Local PostgreSQL container credentials (used only when USE_LOCAL_POSTGRES=true)
POSTGRES_DB=irlobby
POSTGRES_USER=irlobby
POSTGRES_PASSWORD=replace-with-strong-db-password

# Django
SECRET_KEY=replace-with-random-secret
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
WEBSOCKET_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
FRONTEND_BASE_URL=https://your-domain.com
SWIPE_THROTTLE_RATE=120/hour
SWIPE_DAILY_LIMIT=500
MATCH_THROTTLE_RATE=240/hour
REVIEW_CREATE_THROTTLE_RATE=30/hour
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30
CELERY_HEALTHCHECK_TIMEOUT_SECONDS=1.0

# Database URL used by Django.
# Managed DB example:
# DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require
# Neon pooled example:
# DATABASE_URL=postgresql://neondb_owner:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Supabase pooled example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Local DB container example:
# DATABASE_URL=postgresql://irlobby:replace-with-strong-db-password@postgres:5432/irlobby
DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require

# Redis / Celery
# Keep Redis private to Docker networking. Do not expose port 6379 publicly.
# Use a URL-safe password because it is embedded in redis:// URLs.
REDIS_PASSWORD=replace-with-strong-url-safe-redis-password
# Leave these empty to let docker-compose build authenticated internal URLs from REDIS_PASSWORD,
# or set all three explicitly if using an external Redis service.
REDIS_URL=
# Set false only for legacy Redis without requirepass (not recommended long-term).
REDIS_REQUIRE_AUTH=true
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Optional helper value used by deploy/oracle/migrate-to-neon.sh
NEON_DATABASE_URL=

# Optional OAuth
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Comma-separated Google OAuth client IDs (iOS + Android + Web) allowed as id_token audiences
GOOGLE_OAUTH_CLIENT_IDS=
# Apple Sign In JWT audiences (iOS bundle ID)
APPLE_OAUTH_AUDIENCES=com.irlobby.app

# Optional email/password reset
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Optional Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=production
