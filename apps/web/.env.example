# Web OAuth (Google + Apple). Vite bakes these at BUILD time: they must be set in
# the environment of the production `npm run build`. If unset, the buttons are hidden.
# Do not commit real values to git here; client IDs are public but set them via CI/build env.

# Google Identity Services "Web application" OAuth client ID.
# Authorized JavaScript origins must include https://irlobby.com (and https://www.irlobby.com).
VITE_GOOGLE_WEB_CLIENT_ID=

# Apple "Services ID" (not the app bundle ID).
VITE_APPLE_WEB_CLIENT_ID=

# Must exactly match a Return URL registered on the Apple Services ID.
# Defaults to `${window.location.origin}/login` when unset.
VITE_APPLE_REDIRECT_URI=https://irlobby.com/login
