# Django configuration
# keep SECRET_KEY secret in production
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database configuration
# default uses local sqlite; override with a PostgreSQL URL for production
DATABASE_URL=sqlite:///db.sqlite3
# e.g. postgresql://user:password@db:5432/irlobby

# Redis / Celery
# Use a URL-safe password because it is embedded in redis:// URLs.
REDIS_PASSWORD=replace-with-strong-url-safe-redis-password
REDIS_URL=redis://:replace-with-strong-url-safe-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:replace-with-strong-url-safe-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-strong-url-safe-redis-password@redis:6379/0

# CORS / CSRF
# comma-separated list of allowed origins for browser requests
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend base URL (used in password reset links, etc.)
FRONTEND_BASE_URL=http://localhost:5173/

# OAuth / social auth
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_AUDIENCES=com.irlobby.app

# Stripe (ticketed events + Connect payouts). TEST MODE ONLY until Aaron
# greenlights live charges. Use sk_test_ / pk_test_ / whsec_ values.
# STRIPE_SECRET_KEY is accepted as an alias for STRIPE_API_KEY.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=10
STRIPE_CONNECT_COUNTRY=US
STRIPE_REDIRECT_BASE_URL=https://api.irlobby.com
STRIPE_ALLOW_LIVE_MODE=False
STRIPE_SUCCESS_URL=irlobby://tickets/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=irlobby://tickets/cancel
STRIPE_CONNECT_RETURN_URL=irlobby://stripe/connect/return
STRIPE_CONNECT_REFRESH_URL=irlobby://stripe/connect/refresh
ENABLE_TICKETING=True
# The Foyer: free RSVP, optional giving, platform fee always 0. Do not enable live charges.
FOYER_MODE=True

# Email / SMTP (optional for development; console backend is default)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=no-reply@example.com

# Expo push notifications (mobile)
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=

# Any other custom settings can be added below
