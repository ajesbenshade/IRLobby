EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_WEBSOCKET_URL=wss://ws.example.com
EXPO_PUBLIC_TWITTER_CLIENT_ID=your-twitter-client-id
EXPO_PUBLIC_TWITTER_REDIRECT_URI=irlobby://auth/twitter
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=your-google-expo-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
# Optional fallback when platform-specific Google IDs are not set.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=your-mapbox-public-token
# Optional. Hosted ticket Checkout uses the backend STRIPE_API_KEY (sk_test_ only).
# If you add client-side Stripe UI later, use pk_test_… until live mode is approved.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EAS_PROJECT_ID=your-eas-project-id
# Optional: Sentry DSN enables production crash + performance monitoring.
# Leave empty in dev; set in EAS production env or repo secrets for release builds.
EXPO_PUBLIC_SENTRY_DSN=

# Ticket sales UI (Buy ticket, Door scan, Get paid). Off unless set to "true".
EXPO_PUBLIC_ENABLE_TICKETING=false
