# Django settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database
DATABASE_URL=postgres://irlobby:change-me@localhost:5432/irlobby

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Settings
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=https://irlobby.com
SWIPE_THROTTLE_RATE=120/hour
SWIPE_DAILY_LIMIT=500
MATCH_THROTTLE_RATE=240/hour
REVIEW_CREATE_THROTTLE_RATE=30/hour
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30
CELERY_HEALTHCHECK_TIMEOUT_SECONDS=1.0

# Security settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_REFERRER_POLICY=same-origin

# Twitter OAuth
TWITTER_CLIENT_ID=your-twitter-client-id-here
TWITTER_CLIENT_SECRET=your-twitter-client-secret-here

# Stripe (ticketed events + Connect payouts)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=10
STRIPE_CONNECT_COUNTRY=US
STRIPE_SUCCESS_URL=irlobby://tickets/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=irlobby://tickets/cancel
STRIPE_CONNECT_RETURN_URL=irlobby://stripe/connect/return
STRIPE_CONNECT_REFRESH_URL=irlobby://stripe/connect/refresh
ENABLE_TICKETING=True

# Email settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password-here
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Sentry settings
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production
